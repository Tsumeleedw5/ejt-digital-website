# ═══════════════════════════════════════════════════
# EJT DIGITAL — .gitignore
# What must NEVER be committed to the public repo.
# ═══════════════════════════════════════════════════

# OS / Editor cruft
.DS_Store
Thumbs.db
desktop.ini
._*
*.swp
*.swo
*~
.idea/
.vscode/
*.sublime-*

# Environment files (secrets) — never commit any of these
.env
.env.*
!.env.example
*.pem
*.key
secrets.json
config.local.*

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Node / build artifacts (only if you add tooling later)
node_modules/
dist/
build/
.cache/
.parcel-cache/

# Netlify local dev
.netlify/

# System backups
*.bak
*.tmp
*.orig

# Python (if you ever run local build scripts)
__pycache__/
*.pyc
.venv/
venv/

# Google Drive sync artifacts (this folder lives inside a Drive-synced parent)
*.gdoc
*.gsheet
*.gslides

# Preview / render output that shouldn't ship
__preview*
__test*
_notes.md
_DRAFT_*
